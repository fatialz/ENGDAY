{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user role and basic info",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "PJ"] },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record with violation points",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "studentId": { "type": "string" },
        "grade": { "type": "string" },
        "class": { "type": "string" },
        "totalPoints": { "type": "number" },
        "lastViolationAt": { "type": "number" }
      },
      "required": ["id", "name", "studentId", "grade", "class", "totalPoints"]
    },
    "ViolationCategory": {
      "title": "Violation Category",
      "description": "Type of violation and its point value",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "points": { "type": "number" }
      },
      "required": ["id", "name", "points"]
    },
    "Violation": {
      "title": "Violation",
      "description": "A single violation record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "points": { "type": "number" },
        "description": { "type": "string" },
        "violationDate": { "type": "number" },
        "reportedBy": { "type": "string" },
        "reportedById": { "type": "string" }
      },
      "required": ["id", "studentId", "categoryId", "points", "violationDate"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Private user profiles"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student records"
    },
    "/violationCategories/{categoryId}": {
      "schema": "ViolationCategory",
      "description": "Configurable violation types"
    },
    "/violations/{violationId}": {
      "schema": "Violation",
      "description": "Violation logs"
    },
    "/notifications/{notificationId}": {
      "schema": {
        "title": "App Notification",
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "message": { "type": "string" },
          "timestamp": { "type": "number" },
          "read": { "type": "boolean" },
          "targetRoles": { "type": "array", "items": { "type": "string" } }
        }
      },
      "description": "In-app notifications for admins and PJs"
    },
    "/system_config/{configId}": {
      "schema": {
        "title": "System Config",
        "type": "object",
        "properties": {
          "defaultNotificationPrefs": {
            "type": "object",
            "properties": {
              "browserEnabled": { "type": "boolean" },
              "criticalEnabled": { "type": "boolean" },
              "thresholdEnabled": { "type": "boolean" }
            }
          },
          "criticalViolationThreshold": { "type": "number" },
          "pointThreshold": { "type": "number" }
        }
      },
      "description": "Global system configurations"
    }
  }
}
